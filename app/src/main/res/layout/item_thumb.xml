<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/thumbRoot"
    android:layout_width="96dp"
    android:layout_height="132dp"
    android:layout_margin="4dp"
    android:background="@drawable/thumb_bg"
    android:padding="3dp">

    <ImageView
        android:id="@+id/thumbImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_thumb"
        android:scaleType="fitCenter" />

    <View
        android:id="@+id/inkFlag"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/ink_flag"
        android:contentDescription="@string/cd_ink_flag"
        android:visibility="gone" />

    <View
        android:id="@+id/bookmarkFlag"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:background="@drawable/bookmark_flag"
        android:contentDescription="@string/cd_bookmark"
        android:visibility="gone" />

    <View
        android:id="@+id/selFlag"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="@drawable/sel_flag"
        android:contentDescription="@string/cd_select_all"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvThumbPage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="3dp"
        android:textColor="@color/page_text"
        android:textSize="10sp" />

</FrameLayout>
