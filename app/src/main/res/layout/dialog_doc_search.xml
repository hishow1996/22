<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/search_field_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/docSearchGo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="@string/cd_doc_search"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_doc_search"
                android:tint="@color/icon" />

            <EditText
                android:id="@+id/docSearchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/doc_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:textColor="@color/icon"
                android:textColorHint="@color/page_text"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/docSearchClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@null"
                android:contentDescription="@string/cd_doc_search_clear"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search_clear"
                android:tint="@color/page_text"
                android:visibility="gone" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/docSearchClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="@null"
            android:contentDescription="@string/cd_close"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="@color/icon" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/docSearchProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/docSearchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:text="@string/doc_search_idle2"
        android:textColor="@color/page_text"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/docSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <ImageButton
        android:id="@+id/docSearchCopyAll"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:background="@null"
        android:contentDescription="@string/cd_doc_copy_all"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_copy_text"
        android:tint="@color/icon" />

</LinearLayout>
