<?xml version="1.0" encoding="utf-8"?>
<!-- v44：文档内查找条（盖在顶栏上，像 WPS）。高度与顶部内边距由 MainActivity.positionFindBar 按刘海 / 沉浸态设置 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/findBar"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:background="@color/bar"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/search_field_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_doc_search"
            android:tint="@color/page_text" />

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="0dp"
            android:paddingEnd="4dp"
            android:textColor="@color/icon"
            android:textColorHint="@color/page_text"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/findClear"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="@string/cd_doc_search_clear"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search_clear"
            android:tint="@color/page_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="10dp"
            android:minWidth="36dp"
            android:gravity="end"
            android:textColor="@color/page_text"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/findPrev"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:background="@null"
        android:contentDescription="@string/cd_find_prev"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_find_up"
        android:tint="@color/icon" />

    <ImageButton
        android:id="@+id/findNext"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:background="@null"
        android:contentDescription="@string/cd_find_next"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_find_down"
        android:tint="@color/icon" />

    <ImageButton
        android:id="@+id/findList"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:background="@null"
        android:contentDescription="@string/cd_find_list"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_find_list"
        android:tint="@color/icon" />

    <ImageButton
        android:id="@+id/findClose"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:background="@null"
        android:contentDescription="@string/cd_find_close"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        android:tint="@color/icon" />

</LinearLayout>
