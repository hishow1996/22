<?xml version="1.0" encoding="utf-8"?>
<com.moye.pdfink.ZoomHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zoomHost"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/spreadRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pdf_page_horizontal_inset"
        android:paddingEnd="@dimen/pdf_page_horizontal_inset">

        <com.moye.pdfink.PageContainer
            android:id="@+id/pageContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="#FFFFFFFF"
            android:elevation="3dp"
            android:outlineProvider="bounds">

            <com.moye.pdfink.TiledPageView
                android:id="@+id/pageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_prev"
                android:scaleType="fitXY" />

            <com.moye.pdfink.InkView
                android:id="@+id/inkView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.moye.pdfink.PageContainer>

        <!-- v7 双页并排：相邻的下一页。GONE 时不参与 LinearLayout 的 weight 分配 -->
        <com.moye.pdfink.PageContainer
            android:id="@+id/secondContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="#FFFFFFFF"
            android:elevation="3dp"
            android:outlineProvider="bounds"
            android:visibility="gone">

            <com.moye.pdfink.TiledPageView
                android:id="@+id/secondImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_next"
                android:scaleType="fitXY" />

            <com.moye.pdfink.InkView
                android:id="@+id/secondInk"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.moye.pdfink.PageContainer>

        <com.moye.pdfink.PageContainer
            android:id="@+id/draftContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:background="#FFFFFFFF"
            android:elevation="3dp"
            android:outlineProvider="bounds"
            android:visibility="gone">

            <com.moye.pdfink.InkView
                android:id="@+id/draftInk"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_draft" />

        </com.moye.pdfink.PageContainer>

    </LinearLayout>

</com.moye.pdfink.ZoomHost>
