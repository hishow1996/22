<?xml version="1.0" encoding="utf-8"?>
<!-- v63：底部面板。顶部拖动条 → 工具胶囊 + 重做 → 画笔卡片 → 分段标签 → 功能色块 → 亮度卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_bg_top"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/menuHandle"
        android:layout_width="match_parent"
        android:layout_height="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/sheet_handle" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/menuToolRow"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/sheet_pill_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/menuShape"
                style="@style/SheetTool"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_shape"
                android:src="@drawable/ic_shape" />

            <ImageButton
                android:id="@+id/menuLasso"
                style="@style/SheetTool"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_lasso"
                android:src="@drawable/ic_lasso" />

            <ImageButton
                android:id="@+id/menuNote"
                style="@style/SheetTool"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_note"
                android:src="@drawable/ic_note" />

            <ImageButton
                android:id="@+id/menuHighlight"
                style="@style/SheetTool"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:contentDescription="@string/cd_highlighter"
                android:src="@drawable/ic_highlighter" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/menuRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/sheet_round"
            android:contentDescription="@string/cd_redo"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_redo"
            android:tint="@color/icon" />

    </LinearLayout>

    <!-- 画笔卡片：5 档粗细（真实线条粗细）+ 4 个常用笔；沉浸时多一行颜色 -->
    <LinearLayout
        android:id="@+id/menuInkWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/cd_menu_ink"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/menuInkScroll"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menuInkRow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/menuInkRow2"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- 分段标签（代码填充）：手写 / 阅读 / 显示 / 更多 -->
    <LinearLayout
        android:id="@+id/menuTabs"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menuSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="136dp"
            android:orientation="vertical"
            android:paddingTop="12dp" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/menuBrightRow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sun"
            android:tint="@color/icon" />

        <SeekBar
            android:id="@+id/brightnessBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/cd_brightness"
            android:max="100"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:progress="50"
            android:progressDrawable="@drawable/seek_track"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb"
            android:thumbOffset="0dp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sun"
            android:tint="@color/icon" />

    </LinearLayout>

</LinearLayout>
