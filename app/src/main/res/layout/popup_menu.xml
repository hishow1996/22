<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="wrap_content"
    android:layout_height="340dp"
    android:background="@drawable/popup_bg"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/menuToolRow"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/menuShape"
                android:layout_width="34dp"
                android:layout_height="34dp"
                style="@style/ShapeTool"
                android:contentDescription="@string/cd_shape"
                android:src="@drawable/ic_shape" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/mt_shape"
                android:textColor="@color/icon"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/menuLasso"
                android:layout_width="34dp"
                android:layout_height="34dp"
                style="@style/ShapeTool"
                android:contentDescription="@string/cd_lasso"
                android:src="@drawable/ic_lasso" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/mt_lasso"
                android:textColor="@color/icon"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/menuNote"
                android:layout_width="34dp"
                android:layout_height="34dp"
                style="@style/ShapeTool"
                android:contentDescription="@string/cd_note"
                android:src="@drawable/ic_note" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/mt_note"
                android:textColor="@color/icon"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/menuHighlight"
                android:layout_width="34dp"
                android:layout_height="34dp"
                style="@style/ShapeTool"
                android:contentDescription="@string/cd_highlighter"
                android:src="@drawable/ic_highlighter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/mt_highlighter"
                android:textColor="@color/icon"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/menuRedo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                style="@style/ShapeTool"
                android:contentDescription="@string/cd_redo"
                android:src="@drawable/ic_redo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/mt_redo"
                android:textColor="@color/icon"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/menuInkWrap"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/cd_menu_ink"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menuInkRow"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp" />

        </HorizontalScrollView>

        <!-- v59：窄浮层放不下一整行，粗细 5 档单独一行 -->
        <LinearLayout
            android:id="@+id/menuInkRow2"
            android:layout_width="240dp"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp" />


    </LinearLayout>

    <ScrollView
        android:layout_width="240dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menuSections"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>


    <LinearLayout
        android:id="@+id/menuBrightRow"
        android:layout_width="240dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBrightnessIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_brightness"
            android:src="@drawable/ic_sun" />

        <SeekBar
            android:id="@+id/brightnessBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/cd_brightness"
            android:max="100"
            android:progress="50" />

    </LinearLayout>

</LinearLayout>
