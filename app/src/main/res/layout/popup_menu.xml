<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="wrap_content"
    android:layout_height="340dp"
    android:background="@drawable/popup_bg"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/menuToolRow"
        android:layout_width="276dp"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/menuShape"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_shape"
            android:src="@drawable/ic_shape" />

        <ImageButton
            android:id="@+id/menuLasso"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_lasso"
            android:src="@drawable/ic_lasso" />

        <ImageButton
            android:id="@+id/menuNote"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_note"
            android:src="@drawable/ic_note" />

        <ImageButton
            android:id="@+id/menuHighlight"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_highlighter"
            android:src="@drawable/ic_highlighter" />

        <ImageButton
            android:id="@+id/menuRedo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_redo"
            android:src="@drawable/ic_redo" />

    </LinearLayout>

    <View
        android:layout_width="276dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/menuInkWrap"
        android:layout_width="276dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/cd_menu_ink"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="276dp"
            android:layout_height="40dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menuInkRow"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <View
            android:layout_width="276dp"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/divider" />

    </LinearLayout>

    <ScrollView
        android:layout_width="276dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <GridLayout
            android:id="@+id/menuGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:useDefaultMargins="false" />

    </ScrollView>

    <View
        android:layout_width="276dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="276dp"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBrightnessIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_brightness"
            android:src="@drawable/ic_sun" />

        <SeekBar
            android:id="@+id/brightnessBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/cd_brightness"
            android:max="100"
            android:progress="50" />

    </LinearLayout>

</LinearLayout>
