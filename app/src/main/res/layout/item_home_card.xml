<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <!-- 图三：红色圆角方块 + 白色粗体 PDF 字样 -->
    <FrameLayout
        android:id="@+id/cardBadgeFrame"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/pdf_badge_bg"
        android:importantForAccessibility="no">

        <TextView
            android:id="@+id/cardBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:letterSpacing="-0.03"
            android:scaleX="0.84"
            android:text="PDF"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 与文件管理器一致：完整文件名（含 .pdf），不截断、不加省略号 -->
        <TextView
            android:id="@+id/cardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:textColor="@color/icon"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/cardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/page_text"
            android:textSize="12sp" />

    </LinearLayout>

    <View
        android:id="@+id/cardInkDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/home_dot"
        android:visibility="gone" />

</LinearLayout>
