<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Tool">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/tool_bg</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/icon</item>
        <item name="android:contentDescription">@string/cd_tool</item>
    </style>

    <style name="MenuTool">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/menu_bg</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">13dp</item>
        <item name="android:tint">@color/icon</item>
        <item name="android:contentDescription">@string/cd_menu_item</item>
    </style>

    <style name="ShapeTool">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/tool_bg</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">7dp</item>
        <item name="android:tint">@color/icon</item>
        <item name="android:contentDescription">@string/cd_shape</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
</resources>
