<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v53：统一设置面板；v55 起瘦身：说明段落 / 预览 / 完成按钮不再显示，下面带 hint / before / after 的串保留只是为了调用处不用改 -->
    <string name="sheet_done">完成</string>
    <string name="sheet_off">关</string>

    <!-- 写完自动缩小 -->
    <string name="shrink_sheet_title">写完自动缩小</string>
    <string name="shrink_sheet_hint">在页面上放心写大字：停笔 1 秒后，刚写的这一段自动缩小并贴在原处，接着写下一段。缩小后可撤销一步，回到大字。</string>
    <string name="shrink_state_off">已关闭</string>
    <string name="shrink_state_on_hint">缩到原来的</string>
    <string name="shrink_before">写的时候</string>
    <string name="shrink_after">停笔后缩到 %1$d%%</string>
    <string name="shrink_not_on">未开启：写多大就是多大</string>

    <!-- 压感 -->
    <string name="pressure_sheet_title">压感</string>
    <string name="pressure_sheet_hint">触控笔按得越重线条越粗；手指没有压感，不受这个设置影响。</string>
    <string name="pressure_level_off">关</string>
    <string name="pressure_level_soft">弱</string>
    <string name="pressure_level_normal">标准</string>
    <string name="pressure_level_strong">强</string>
    <string name="pressure_desc_off">粗细只看笔速</string>
    <string name="pressure_desc_soft">力度影响小，线条均匀</string>
    <string name="pressure_desc_normal">轻重有变化，不夸张</string>
    <string name="pressure_desc_strong">轻重对比大，适合写笔锋</string>

    <!-- 手指书写偏移 -->
    <string name="finger_sheet_title">手指书写偏移</string>
    <string name="finger_sheet_hint">用手指写画时，落笔点上移到指尖上方，并画出光标环，笔迹不再被手指挡住，也更容易圈准位置。触控笔不受影响。</string>
    <string name="finger_level_off">关</string>
    <string name="finger_level_small">小</string>
    <string name="finger_level_medium">中</string>
    <string name="finger_level_large">大</string>
    <string name="finger_desc_off">笔迹落在手指正下方</string>
    <string name="finger_desc_small">上移约 32dp，适合手指细</string>
    <string name="finger_desc_medium">上移约 48dp，多数人合适</string>
    <string name="finger_desc_large">上移约 64dp，手指粗选这档</string>

    <!-- 页面底色 -->
    <string name="tint_sheet_title">页面底色</string>
    <string name="tint_sheet_hint">只改变显示效果，不会修改原文件，也不影响已写的批注。</string>
    <string name="tint_level_white">白底</string>
    <string name="tint_level_warm">护眼</string>
    <string name="tint_level_night">夜间</string>
    <string name="tint_desc_white">保持文件原色</string>
    <string name="tint_desc_warm">偏暖米黄，更柔和</string>
    <string name="tint_desc_night">深底浅字，夜里不刺眼</string>
</resources>
