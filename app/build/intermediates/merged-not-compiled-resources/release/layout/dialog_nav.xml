<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/navPage"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/nav_input_bg"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/icon"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/navGo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_jump"
            android:src="@drawable/ic_check" />

        <ImageButton
            android:id="@+id/btnNextInk"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_next_ink"
            android:src="@drawable/ic_next_ink" />

        <ImageButton
            android:id="@+id/btnNextBookmark"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_next_bookmark"
            android:src="@drawable/ic_star" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/navClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            style="@style/ShapeTool"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/navBookmarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/navShelf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
