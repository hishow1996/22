<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/importModeRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_bg"
    android:contentDescription="@string/cd_shelf_actions"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageButton
        android:id="@+id/btnImportMerge"
        android:layout_width="52dp"
        android:layout_height="52dp"
        style="@style/MenuTool"
        android:contentDescription="@string/cd_merge"
        android:src="@drawable/ic_merge" />

    <ImageButton
        android:id="@+id/btnImportReplace"
        android:layout_width="52dp"
        android:layout_height="52dp"
        style="@style/MenuTool"
        android:contentDescription="@string/cd_replace"
        android:src="@drawable/ic_replace" />

</LinearLayout>
